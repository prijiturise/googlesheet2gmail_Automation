    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nconst validRows = rows.filter(item => {\n  const row = item.json;\n  return row.Name || row.Course || row.Status;\n});\n\nif (validRows.length === 0) {\n  return [];\n}\n\nconst details = validRows.map((item, index) => {\n  const row = item.json;\n\n  return `${index + 1}. ${row.Name || \"Not provided\"}\n   Course: ${row.Course || \"Not provided\"}\n   Status: ${row.Status || \"Not provided\"}`;\n}).join(\"\\n\\n\");\n\nconst statuses = validRows.map(item =>\n  item.json.Status || \"Not provided\"\n);\n\nconst uniqueStatuses = [...new Set(statuses)];\n\nconst subject = uniqueStatuses.length === 1\n  ? `Student Status Report - ${uniqueStatuses[0]}`\n  : \"Student Status Report - Multiple Statuses\";\n\nconst body = `Hello,\n\nPlease find below the latest student status report.\n\n${details}\n\nTotal students: ${validRows.length}\n\nRegards,\nYour Automation Bot`;\n\nreturn [{\n  json: {\n    subject,\n    body,\n    recordCount: validRows.length\n  }\n}];\n"
      },
